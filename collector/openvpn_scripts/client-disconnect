#!/usr/bin/env python3
"""
Wrapper для client-disconnect скрипта OpenVPN.
Вызывается при отключении клиента.

Установка:
    mkdir -p /etc/openvpn/scripts
    cp collector/openvpn_scripts/client-disconnect /etc/openvpn/scripts/
    chmod +x /etc/openvpn/scripts/client-disconnect

Настройка OpenVPN (/etc/openvpn/server.conf):
    script-security 2
    client-disconnect /etc/openvpn/scripts/client-disconnect

Переменные клиента OpenVPN передаёт сам — setenv-safe не нужен (он добавляет
префикс OPENVPN_ к имени). Подробности: collector/openvpn_scripts/README.md
"""
import sys
import os

# Добавляем путь к проекту для импорта модулей
# Предполагается, что проект установлен в /opt/openvpn-logserver
# Если путь другой - измените его здесь или задайте переменную окружения
PROJECT_PATH = os.environ.get('OPENVPN_LOGSERVER_PATH', '/opt/openvpn-logserver')
sys.path.insert(0, PROJECT_PATH)

try:
    from collector.client_disconnect import main
except BaseException as e:  # noqa: BLE001 — VPN важнее логов
    print(f"Error: Cannot import collector.client_disconnect: {e}", file=sys.stderr)
    print(f"Make sure PROJECT_PATH is correct: {PROJECT_PATH}", file=sys.stderr)
    sys.exit(0)  # Не блокируем VPN при ошибке

if __name__ == '__main__':
    try:
        sys.exit(main())
    except BaseException as e:  # noqa: BLE001
        print(f"client-disconnect fatal error: {e}", file=sys.stderr)
        sys.exit(0)
