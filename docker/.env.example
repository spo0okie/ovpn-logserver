# OpenVPN LogServer - Docker environment variables.
# Скопируйте в .env и установите свои значения. .env в git НЕ коммитится.

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=REPLACE_ME
MYSQL_DATABASE=openvpn_logs
MYSQL_USER=openvpn
MYSQL_PASSWORD=REPLACE_ME

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_ME_WITH_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Web auth (bcrypt-хеш). python -c "from passlib.hash import bcrypt; print(bcrypt.hash('password'))"
WEB_AUTH_USERNAME=admin
WEB_AUTH_PASSWORD_HASH=REPLACE_ME

# -----------------------------------------------------------------------------
# OpenVPN
# -----------------------------------------------------------------------------
VPN_SUBNET=10.8.0.0
VPN_NETMASK=255.255.255.0

KEY_COUNTRY=RU
KEY_PROVINCE=MSK
KEY_CITY=Moscow
KEY_ORG=OpenVPN-LogServer
KEY_EMAIL=admin@example.com
KEY_OU=IT
KEY_NAME=server

# Интервал фоновой синхронизации в контейнере openvpn-server, секунды.
# 0 — отключить (тогда sync_all.py запускается только вручную).
SYNC_INTERVAL=300
