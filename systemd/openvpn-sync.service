[Unit]
Description=OpenVPN Data Sync
Documentation=https://github.com/spo0okie/ovpn-logserver
After=mysql.service

[Service]
Type=oneshot
# Работа от root (упрощенная установка)
User=root
Group=root
WorkingDirectory=/opt/openvpn-logserver

Environment=PYTHONPATH=/opt/openvpn-logserver
# Пароль БД больше не требуется в переменных окружения - читается из config/database.yaml
# Роль синка: all — single-site. На админ-хосте мультисайта переопределить
# drop-in'ом на central (systemctl edit openvpn-sync.service), иначе
# ccd_checker зарегистрирует фантомный сервер "local" — см. docs/multisite.md
Environment=SYNC_ROLE=all

# Запуск через отдельный Python-скрипт
# Интерпретатор: системный python3 — как в «быстром старте» docs/deployment.md,
# где зависимости ставятся глобально. При установке в venv заменить на
# /opt/openvpn-logserver/venv/bin/python
ExecStart=/usr/bin/python3 /opt/openvpn-logserver/collector/sync_all.py

# [Install] намеренно нет: юнит запускает таймер (openvpn-sync.timer).
# `systemctl enable openvpn-sync.service` добавил бы лишний запуск при загрузке.
