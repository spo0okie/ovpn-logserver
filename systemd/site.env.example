# Env-файл инстанса OpenVPN для openvpn-sync-site@.service.
# Положить в /etc/openvpn-logserver/<имя инстанса>.env, например chl.env,
# и включить таймер: systemctl enable --now openvpn-sync-site@chl.timer
#
# Значения обязаны совпадать с server.conf этого инстанса:
#   OPENVPN_CCD_DIR     = client-config-dir
#   OPENVPN_MGMT_SOCKET = management <путь> unix
# Хукам нужно только имя — его передаёт `setenv OPENVPN_SERVER_NAME ...`
# в том же server.conf. Подробности: docs/multisite.md

OPENVPN_SERVER_NAME=chl
OPENVPN_CCD_DIR=/etc/openvpn/mobile/ccd
OPENVPN_MGMT_SOCKET=/run/openvpn/mgmt-chl.sock
# Свой lock на инстанс: общий дефолтный заставил бы таймеры инстансов
# одного хоста пропускать запуски друг друга
SYNC_LOCK_PATH=/var/run/openvpn-logserver/sync-chl.lock
