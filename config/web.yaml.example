# Конфигурация веб-приложения. Скопируйте в web.yaml.
# Читается напрямую web/main.py; используются ТОЛЬКО ключи ниже.
# Хост, порт и число воркеров — параметры uvicorn в openvpn-web.service.

app:
  # true открывает /docs, /redoc, /openapi.json — в проде false
  debug: false

# CORS жёстко ограничен. ENV CORS_ALLOW_ORIGINS (через запятую) перекрывает
# allow_origins. ["*"] вместе с credentials небезопасен — CORS отключится целиком.
cors:
  allow_origins: []
  allow_methods: ["GET", "POST"]
  allow_headers: ["*"]
