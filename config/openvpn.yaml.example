# Конфигурация OpenVPN для collector модулей.
# Скопируйте в openvpn.yaml и при необходимости поправьте пути.
# Переопределяется ENV: OPENVPN_BASE_DIR, OPENVPN_CERTS_DIR, OPENVPN_CERT_EXTENSION,
#                       OPENVPN_CRL_FILE, OPENVPN_CCD_DIR, OPENVPN_MGMT_SOCKET,
#                       OPENVPN_SERVER_NAME

openvpn:
  base_dir: /etc/openvpn
  certs_dir: /etc/openvpn/certs
  cert_extension: .crt
  crl_file: /etc/openvpn/crl.pem
  ccd_dir: /etc/openvpn/ccd
  management_socket: /var/run/openvpn/mgmt.sock
  # Имя ЭТОГО инстанса OpenVPN (мультисайт, docs/multisite.md): chl, msk-2fa, ...
  # Для single-site можно оставить дефолт. У 2FA-инстанса — своё имя.
  server_name: local

# Пример для сервера сайта в мультисайте (provision/multisite):
#   cert_extension: .pem              # админ-хост кладёт certs/*.pem
#   crl_file: /etc/openvpn/crl/crl.pem
#   ccd_dir: /etc/openvpn/mobile/ccd  # remoteCcdDir из provision
#   server_name: chl                  # код сайта (+ "-2fa" для 2FA-инстанса)
